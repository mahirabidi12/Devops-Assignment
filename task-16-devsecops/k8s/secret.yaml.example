# TEMPLATE ONLY. Copy to secret.yaml, fill in real values, and do not commit it.
#
# A Kubernetes Secret is base64, not encryption - demonstrated in task 11, where
# `kubectl exec -- env` showed the password in plaintext inside the container.
# For anything real use Sealed Secrets, SOPS, or an external secrets operator
# pulling from Vault or AWS Secrets Manager.
apiVersion: v1
kind: Secret
metadata:
  name: devsecops-api-secret
type: Opaque
stringData:
  # stringData takes plaintext and base64-encodes it for you, which avoids the
  # trailing-newline bug that `echo | base64` causes.
  API_KEY: "replace-me"
  DATABASE_URL: "postgresql://user:replace-me@postgres:5432/appdb"
